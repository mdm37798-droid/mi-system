import datetime
import os

def system_health_check():
    file_size = os.path.getsize("mi_system.py")
    current_time = datetime.datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    log_msg = f"[{current_time}] System Health OK | Master Body Size: {file_size} bytes\n"
    
    # system.log ফাইলে এন্ট্রি যোগ করা (আলাদা ফাইল নয়, সিস্টেমের নিজস্ব লগ)
    with open("system.log", "a", encoding="utf-8") as log_f:
        log_f.write(log_msg)
    
    print(f"\n--- [M I System Health & Diagnostics] ---")
    print(f"Status: Operational & Secure")
    print(f"Master Body Size: {file_size} bytes")
    print(f"Timestamp: {current_time}")
    print(f"----------------------------------------")

if __name__ == "__main__":
    system_health_check()

# ====================================================
# [M I System] - Complete Unified Core Architecture
# ====================================================

import json
import os

# --- ১. মেমোরি ও ডাটা লেয়ার (Memory & Data Layer) ---
IDENTITY_FILE = "identity.json"
KNOWLEDGE_FILE = "knowledge.json"

def init_storage():
    # সুপ্রিম আইডেন্টিটি ফাইল তৈরি
    if not os.path.exists(IDENTITY_FILE):
        default_identity = {
            "commander": "এম কমান্ড (মিজান)",
            "role": "Supreme Commander",
            "clearance_level": "Root Access"
        }
        with open(IDENTITY_FILE, "w", encoding="utf-8") as f:
            json.dump(default_identity, f, ensure_ascii=False, indent=4)

    # লোকাল নলেজ বেজ ফাইল তৈরি
    if not os.path.exists(KNOWLEDGE_FILE):
        default_knowledge = {
            "system_goal": "হিউম্যান বডি অ্যানালজির আদলে একটি স্বয়ংসম্পূর্ণ ও বুদ্ধিদীপ্ত এম আই (M I) সত্তা গড়ে তোলা।",
            "architecture": "Living Modular Organism & Offline-First"
        }
        with open(KNOWLEDGE_FILE, "w", encoding="utf-8") as f:
            json.dump(default_knowledge, f, ensure_ascii=False, indent=4)

# --- ২. লজিক ও প্যাচিং লেয়ার (Logic & Self-Patching Layer) ---
def load_data(file_path):
    if os.path.exists(file_path):
        with open(file_path, "r", encoding="utf-8") as f:
            return json.load(f)
    return {}

def update_identity(key, value):
    data = load_data(IDENTITY_FILE)
    data[key] = value
    with open(IDENTITY_FILE, "w", encoding="utf-8") as f:
        json.dump(data, f, ensure_ascii=False, indent=4)
    return f"এম কমান্ড, সুপ্রিম আইডেন্টিটি আপডেট সফল: {key} -> {value}"

def patch_knowledge(key, value):
    data = load_data(KNOWLEDGE_FILE)
    data[key] = value
    with open(KNOWLEDGE_FILE, "w", encoding="utf-8") as f:
        json.dump(data, f, ensure_ascii=False, indent=4)
    return f"এম কমান্ড, লোকাল নলেজ প্যাচ সফল: {key} -> {value}"

# --- ৩. কোর প্রসেসিং ও এক্সিকিউশন (Core Execution) ---
def main():
    init_storage()
    print("==================================================")
    print("  [M I System] সফলভাবে ইনিশিয়ালাইজ করা হয়েছে!  ")
    print("==================================================")
    
    # বর্তমান ডেটা চেক
    identity = load_data(IDENTITY_FILE)
    knowledge = load_data(KNOWLEDGE_FILE)
    
    print(f"-> সুপ্রিম কমান্ডার: {identity.get('commander')}")
    print(f"-> সিস্টেম লক্ষ্য: {knowledge.get('system_goal')}")
    print("--------------------------------------------------")

if __name__ == "__main__":
    main()


